# Banco central do control plane (Neon, projeto separado de qualquer cliente)
DATABASE_URL="postgresql://usuario:senha@host/ecdise_control?schema=public"

# Chave usada para criptografar as connection strings dos bancos de cada
# cliente antes de guardar no banco central. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Segredo compartilhado entre o control-plane e o Ecdise, para autenticar a
# chamada que o login multi-tenant do Ecdise faz em /api/login-roteamento.
# Gerar com o mesmo comando acima (outro valor, não reaproveitar).
CONTROL_PLANE_INTERNAL_SECRET=""

# API Key do Neon, para automatizar a criação de banco por cliente (fase 2)
NEON_API_KEY=""

# URL do Ecdise multi-tenant (o produto em si) — usado pra provisionar o
# primeiro usuário/senha de cada empresa quando você cria um acesso aqui.
ECDISE_APP_URL="http://localhost:3000"

# Senha do painel administrativo do control-plane (login único, sem cadastro
# de usuário — é só você quem acessa). Troque por uma senha forte.
ADMIN_PASSWORD=""

# Segredo usado para assinar o cookie de sessão do painel admin. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_SESSION_SECRET=""
